# Frontend build-time settings (Vite). Copy to .env.local if you need to change them.
# Only variables prefixed VITE_ are exposed to browser code. Never put secrets here:
# everything in the frontend bundle is public.

# Base URL of the VIDSGEN API. Empty = same origin (dev server proxies /api to the backend).
# Example for a separately hosted API: https://api.example.com
VITE_API_BASE_URL=

# Dev/preview server only: where the /api proxy forwards requests.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
