          "guidance_scale",
          "seed",
          "prompt",
          "image",
          "defaults"
        ],
        "title": "LimitsOut",
        "description": "What this server will accept for a generation request, so a client can offer only valid choices and explain the rest.\n\nIndependent of GPU availability: it describes configuration, not provider state. POST /api/jobs enforces exactly these limits\n(omitted form fields still take the API's own defaults, which may exceed them on a restricted server: send explicit values)."
      },
      "ModeLimit": {
        "properties": {
          "value": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "False = this server does not offer the mode; show it disabled and explain why"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Why it is disabled (None when enabled)"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label",
          "enabled",
          "reason"
        ],
        "title": "ModeLimit"
      },
      "PromptLimit": {
        "properties": {
          "max_chars": {
            "type": "integer",
            "title": "Max Chars"
          }
        },
        "type": "object",
        "required": [
          "max_chars"
        ],
        "title": "PromptLimit"
      },
      "RangeLimit": {
        "properties": {
