{
  "openapi": "3.1.0",
  "info": {
    "title": "VIDSGEN API",
    "description": "Video generation API for VIDSGEN (Wan 2.2 TI2V-5B).\n\nSubmit a text-to-video or image-to-video job, poll it for progress, then preview or download the MP4. The GPU backend is pluggable; this instance uses the provider shown by `/api/health`.",
    "version": "0.4.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service health",
        "description": "Always returns 200 while the API is up. `status` is `degraded` when the inference\nprovider or storage cannot accept work (e.g. the GPU host is offline, or its model files\nare missing or have the wrong size). `provider.checks` reports each aspect separately;\nfor a GPU provider, weight integrity and inference stay \"unverified\" until a real\ngeneration has succeeded, so `ok` never claims inference readiness.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Submit a text-to-video or image-to-video job",
        "description": "Validates the request, stores it, and queues it. Returns **202** immediately;\npoll `GET /api/jobs/{id}` for status and progress.",
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_job_api_jobs_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Generation history (newest first)",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/JobStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job status, progress and details",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel a queued or processing job",
        "operationId": "cancel_job_api_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Job already finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/download": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Download (or preview) the generated video",
        "description": "`inline=false` (default) sends `Content-Disposition: attachment` for a download.\n`inline=true` serves the same file for in-browser preview. Range requests are\nsupported for seeking.",
        "operationId": "download_api_jobs__job_id__download_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "inline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Inline"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The MP4 file (supports HTTP Range requests)",
            "content": {
              "video/mp4": {}
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Job is not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "410": {
            "description": "Result file is no longer available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/limits": {
      "get": {
        "tags": [
          "limits"
        ],
        "summary": "Generation limits and defaults for this server",
        "description": "The active generation capabilities: which modes and resolutions are offered, valid frame counts, step/fps/guidance ranges, upload\nand prompt limits, and starting values. Computed from the same configuration that validates `POST /api/jobs`; it never contacts\nthe GPU provider and contains no URLs, credentials or paths.",
        "operationId": "limits_api_limits_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LimitsOut"
                }
              }
            }
          },
          "500": {
            "description": "The server's generation limits are misconfigured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_create_job_api_jobs_post": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GenerationMode",
            "description": "t2v = text-to-video, i2v = image-to-video"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "negative_prompt": {
            "type": "string",
            "title": "Negative Prompt",
            "default": ""
          },
          "resolution": {
            "type": "string",
            "title": "Resolution",
            "description": "1280x704, 704x1280, 832x480, 480x832 or 640x640",
            "default": "832x480"
          },
          "num_frames": {
            "type": "integer",
            "title": "Num Frames",
            "description": "4k+1, between 17 and 121",
            "default": 49
          },
          "fps": {
            "type": "integer",
            "title": "Fps",
            "default": 24
          },
          "steps": {
            "type": "integer",
            "title": "Steps",
            "default": 30
          },
          "guidance_scale": {
            "type": "number",
            "title": "Guidance Scale",
            "default": 5.0
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image",
            "description": "Required for i2v (JPEG/PNG/WEBP); not allowed for t2v"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "prompt"
        ],
        "title": "Body_create_job_api_jobs_post"
      },
      "ComponentHealth": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "description": "Whether the component can accept work now. For a GPU provider this does NOT mean inference is verified; see checks."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/HealthCheckOut"
            },
            "type": "array",
            "title": "Checks",
            "description": "Separately reported aspects (may be empty)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ComponentHealth"
      },
      "DefaultsOut": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "resolution": {
            "type": "string",
            "title": "Resolution"
          },
          "num_frames": {
            "type": "integer",
            "title": "Num Frames"
          },
          "steps": {
            "type": "integer",
            "title": "Steps"
          },
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "guidance_scale": {
            "type": "number",
            "title": "Guidance Scale"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "resolution",
          "num_frames",
          "steps",
          "fps",
          "guidance_scale"
        ],
        "title": "DefaultsOut",
        "description": "Starting values for a form. Every one is valid under the limits in the same response."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "FramesLimit": {
        "properties": {
          "min": {
            "type": "integer",
            "title": "Min"
          },
          "max": {
            "type": "integer",
            "title": "Max",
            "description": "The largest frame count this server accepts"
          },
          "step": {
            "type": "integer",
            "title": "Step",
            "description": "Valid counts are min, min+step, ... (always 4k+1)"
          },
          "allowed": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Allowed",
            "description": "Every valid frame count"
          },
          "limited": {
            "type": "boolean",
            "title": "Limited",
            "description": "True if this server accepts fewer frames than the model supports"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "min",
          "max",
          "step",
          "allowed",
          "limited",
          "reason"
        ],
        "title": "FramesLimit"
      },
      "GenerationMode": {
        "type": "string",
        "enum": [
          "t2v",
          "i2v"
        ],
        "title": "GenerationMode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthCheckOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "e.g. comfyui_reachable, model_files_detected, model_file_sizes, model_weights_integrity, inference"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "unverified"
            ],
            "title": "Status",
            "description": "'unverified' = could not be established, not a failure"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "HealthCheckOut"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "provider": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "storage": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "jobs": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment",
          "provider",
          "storage",
          "jobs"
        ],
        "title": "HealthOut"
      },
      "ImageLimit": {
        "properties": {
          "mime_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Mime Types"
          },
          "max_bytes": {
            "type": "integer",
            "title": "Max Bytes"
          },
          "min_side": {
            "type": "integer",
            "title": "Min Side"
          },
          "max_side": {
            "type": "integer",
            "title": "Max Side"
          }
        },
        "type": "object",
        "required": [
          "mime_types",
          "max_bytes",
          "min_side",
          "max_side"
        ],
        "title": "ImageLimit"
      },
      "InputImageOut": {
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "original_format": {
            "type": "string",
            "title": "Original Format"
          },
          "original_size_bytes": {
            "type": "integer",
            "title": "Original Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "width",
          "height",
          "original_format",
          "original_size_bytes"
        ],
        "title": "InputImageOut"
      },
      "IntRangeLimit": {
        "properties": {
          "min": {
            "type": "integer",
            "title": "Min"
          },
          "max": {
            "type": "integer",
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "title": "IntRangeLimit"
      },
      "JobError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "JobError"
      },
      "JobListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/JobOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "JobListOut"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "mode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "progress": {
            "type": "number",
            "title": "Progress",
            "description": "0-100"
          },
          "params": {
            "$ref": "#/components/schemas/JobParamsOut"
          },
          "input_image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InputImageOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "mode",
          "status",
          "progress",
          "params",
          "input_image",
          "result",
          "error",
          "provider",
          "created_at",
          "updated_at",
          "started_at",
          "completed_at"
        ],
        "title": "JobOut"
      },
      "JobParamsOut": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "negative_prompt": {
            "type": "string",
            "title": "Negative Prompt"
          },
          "resolution": {
            "type": "string",
            "title": "Resolution"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "num_frames": {
            "type": "integer",
            "title": "Num Frames"
          },
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "steps": {
            "type": "integer",
            "title": "Steps"
          },
          "guidance_scale": {
            "type": "number",
            "title": "Guidance Scale"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "prompt",
          "negative_prompt",
          "resolution",
          "width",
          "height",
          "num_frames",
          "fps",
          "duration_seconds",
          "steps",
          "guidance_scale",
          "seed"
        ],
        "title": "JobParamsOut"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "LimitsOut": {
        "properties": {
          "profile": {
            "type": "string",
            "title": "Profile",
            "description": "Active generation profile: `unrestricted` or a verified GPU profile such as `t4_verified`"
          },
          "restricted": {
            "type": "boolean",
            "title": "Restricted",
            "description": "True if any limit below is stricter than the model's own"
          },
          "max_concurrent_jobs": {
            "type": "integer",
            "title": "Max Concurrent Jobs",
            "description": "Jobs run this many at a time; others wait in the queue"
          },
          "modes": {
            "items": {
