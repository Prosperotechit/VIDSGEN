# Copy to .env and fill in locally. NEVER commit .env.
# Every value here is read by the backend through environment variables, so the
# same code runs locally, in Docker, or on any host.

# ---------------------------------------------------------------- app
APP_ENV=development              # development | production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./storage/vidsgen.db

# ---------------------------------------------------------------- inference
# Which provider executes generation jobs. Swapping GPU hosts = changing this
# block only; the frontend and job logic are unaffected.
INFERENCE_PROVIDER=mock          # mock | comfyui
INFERENCE_TIMEOUT_SECONDS=1800
INFERENCE_MAX_CONCURRENT_JOBS=1

# Used when INFERENCE_PROVIDER=comfyui (Kaggle tunnel today, any host later)
COMFYUI_URL=                     # e.g. https://<random>.trycloudflare.com
COMFYUI_API_TOKEN=               # shared secret checked by the token proxy

# ---------------------------------------------------------------- storage
# Where finished videos and uploaded images are kept. Kept independent of
# the GPU provider so results survive when a Kaggle session ends.
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=         # optional CDN base URL for served videos

# Used when STORAGE_BACKEND=s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- limits
MAX_UPLOAD_MB=10
MAX_PROMPT_CHARS=2000
