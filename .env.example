# Copy to .env and fill in locally. NEVER commit .env.
# Every value here is read by the backend through environment variables, so the
# same code runs locally, in Docker, or on any host.

# ---------------------------------------------------------------- app
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=                    # empty = <storage root>/vidsgen.db; only sqlite:/// supported for now

# ---------------------------------------------------------------- inference
# Which provider executes generation jobs. Swapping GPU hosts = changing this
# block only; the frontend and job logic are unaffected.
INFERENCE_PROVIDER=mock          # mock | comfyui
INFERENCE_TIMEOUT_SECONDS=1800
INFERENCE_MAX_CONCURRENT_JOBS=1

# Used when INFERENCE_PROVIDER=comfyui (Kaggle tunnel today, any GPU host later).
# Server-side only: the frontend never sees these and never talks to ComfyUI.
# ComfyUI must NOT be exposed publicly without the token proxy in front of it.
COMFYUI_BASE_URL=                # http://127.0.0.1:<port> (same machine) or https://<host> (remote). Remote REQUIRES https and a token
COMFYUI_API_TOKEN=               # shared secret (>= 32 chars, required for a remote URL), sent as "Authorization: Bearer ..."; never logged
COMFYUI_TIMEOUT=30               # seconds per HTTP request to ComfyUI (whole job: INFERENCE_TIMEOUT_SECONDS)
COMFYUI_CLIENT_ID=               # empty = "vidsgen-<random>" per backend process
COMFYUI_POLL_INTERVAL=2          # seconds between status checks when WebSocket events are unavailable
COMFYUI_WORKFLOWS_DIR=           # empty = <repo>/workflows/comfyui
COMFYUI_CONNECTION_GRACE_SECONDS=30   # a running job survives a lost ComfyUI connection this long (0 = fail at once)

# GPU generation envelope: reject requests the GPU host has not been verified for (422 with a clear message).
# Enforced at the API boundary only (POST /api/jobs), not inside JobManager. Image-to-video stays off until tested on a GPU.
# unrestricted (default, mock provider) | t4_verified = 832x480, text-to-video only, <=17 frames, <=20 steps, 1 job at a time
GENERATION_PROFILE=unrestricted
# Optional overrides of the preset (blank = preset / no limit):
GENERATION_ALLOWED_MODES=            # t2v | t2v,i2v
GENERATION_ALLOWED_RESOLUTIONS=      # e.g. 832x480 or 832x480,480x832
GENERATION_MAX_FRAMES=               # 17..121
GENERATION_MAX_STEPS=                # 1..60

# Mock provider (development only): seconds per simulated denoising step
MOCK_STEP_DELAY_SECONDS=0.15

# ---------------------------------------------------------------- storage
# Where finished videos and uploaded images are kept. Kept independent of
# the GPU provider so results survive when a Kaggle session ends.
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=              # empty = <repo>/storage (git-ignored). Must not be inside backend/app.
STORAGE_PUBLIC_BASE_URL=         # optional CDN base URL for served videos

# Used when STORAGE_BACKEND=s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- limits
MAX_UPLOAD_MB=10
MAX_PROMPT_CHARS=2000
MIN_IMAGE_SIDE=256
MAX_IMAGE_SIDE=4096
